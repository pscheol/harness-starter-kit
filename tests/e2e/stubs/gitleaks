#!/usr/bin/env python3
"""가짜 gitleaks(e2e) — 두 구성 e2e 는 정적 분석기를 시험하지 않는다. 판을 답하고 빈 SARIF 를 낸다(affected 검증 · mr 앞 조건을 채우려고)."""
import json
import sys

args = sys.argv[1:]
if args[:1] == ["version"]:
    print("8.21.2")
    sys.exit(0)
if "--report-path" in args:
    out = args[args.index("--report-path") + 1]
    with open(out, "w", encoding="utf-8") as handle:
        json.dump({"version": "2.1.0", "runs": [{"tool": {"driver": {"name": "gitleaks", "rules": []}}, "results": []}]}, handle)
sys.exit(0)
