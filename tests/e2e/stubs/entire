#!/usr/bin/env python3
"""가짜 entire(e2e-stub, 설계 11 §3.4) — enable 이 .entire/ 와 하네스 훅을 만들고, 체크포인트는 시험 대본이 `entire checkpoint-make` 로 만든다.

checkpoint-make <커밋> : 그 커밋에 Entire-Checkpoint 트레일러가 든 메시지를 만들 수 없으므로(커밋은 이미 있다) ref 만 만든다.
실제 Entire 는 구현 하네스 훅이 커밋마다 트레일러 + refs/entire/checkpoints/<id> 를 만든다. 이 가짜는 그 결과 모양만 낸다.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

args = sys.argv[1:]
log = os.environ.get("E2E_LOG")
if log:
    with open(log, "a", encoding="utf-8") as handle:
        handle.write("entire " + " ".join(args) + "\n")


def add_hook(file, event, command):
    path = Path(file)
    data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    data.setdefault("hooks", {}).setdefault(event, []).append({"matcher": "", "hooks": [{"type": "command", "command": command}]})
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


cmd = args[0] if args else ""
if cmd == "--version":
    print("Entire CLI 0.13.4")
elif cmd == "enable":
    agent = args[args.index("--agent") + 1] if "--agent" in args else ""
    Path(".entire").mkdir(exist_ok=True)
    Path(".entire/settings.json").write_text(json.dumps({"enabled": True, "checkpoints": {"primary": {"type": "git-refs"}}}, indent=2) + "\n", encoding="utf-8")
    Path(".entire/.gitignore").write_text("tmp/\n", encoding="utf-8")
    if agent == "claude-code":
        add_hook(".claude/settings.json", "Stop", "exec entire hooks claude-code stop")
    elif agent == "codex":
        add_hook(".codex/hooks.json", "Stop", "exec entire hooks codex stop")
elif cmd == "configure":
    Path(".entire").mkdir(exist_ok=True)
    Path(".entire/settings.json").write_text(json.dumps({"enabled": True, "strategy_options": {"push_sessions": False}, "checkpoints": {"primary": {"type": "git-refs"}}}, indent=2) + "\n", encoding="utf-8")
elif cmd == "checkpoint" and len(args) > 2 and args[1] == "explain":
    print(f"체크포인트 {args[2]} 설명(가짜)")
elif cmd == "checkpoint-make":
    sha = args[1]
    cid = args[2]
    subprocess.run(["git", "update-ref", f"refs/entire/checkpoints/{cid[:2]}/{cid[2:]}", sha], check=True)
