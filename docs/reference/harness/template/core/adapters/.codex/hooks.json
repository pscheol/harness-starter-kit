{
  "_comment": "Codex 어댑터. Claude 어댑터와 동일한 공용 scripts/ 를 호출한다. 한쪽만 바꾸면 verify-harness 가 드리프트를 경고한다.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/assert-harness-context.cjs",
            "statusMessage": "Checking harness context..."
          },
          {
            "type": "command",
            "command": "node scripts/install-pkgs-if-remote.cjs",
            "statusMessage": "Checking dependencies..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/format-and-lint-hook.cjs",
            "statusMessage": "Formatting & linting..."
          }
        ]
      }
    ]
  }
}
