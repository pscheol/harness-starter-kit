%%{init: {"theme": "base", "fontFamily": "Apple SD Gothic Neo, AppleSDGothicNeo, Noto Sans KR, Malgun Gothic, sans-serif", "themeVariables": {"fontFamily": "Apple SD Gothic Neo, AppleSDGothicNeo, Noto Sans KR, Malgun Gothic, sans-serif", "fontSize": "16px", "primaryColor": "#ffffff", "primaryBorderColor": "#14213d", "primaryTextColor": "#14213d", "lineColor": "#46536b", "clusterBkg": "#f5f7fa", "clusterBorder": "#aeb9c7", "edgeLabelBackground": "#f5f7fa"}, "flowchart": {"curve": "basis", "padding": 16, "nodeSpacing": 30, "rankSpacing": 40}}}%%
graph LR
  subgraph ST["문서 하나의 status"]
    direction TB
    D["draft<br/>세션이 쓴다"]
    IR["in-review<br/>질문 0 · CLARIFICATION 0"]
    AP["approved<br/>기록 sha = 현재 sha"]
    SU["superseded<br/>새 판으로 대체"]
    D -- "세션이 올린다" --> IR
    IR -- "사람 승인 4경로" --> AP
    AP --> SU
    AP -. "내용이 바뀌면 stale" .-> IR
  end
  subgraph INT["Intent 폴더 approvals.md"]
    direction TB
    G1["codebase<br/>current-state.md"]
    G2["intent<br/>intent.md · units.json"]
    G3["plans<br/>plans/*.md"]
    G1 --> G2 --> G3
  end
  subgraph ISS["이슈 폴더 approvals.md"]
    direction TB
    G4["requirements · 하한"]
    G5["design · 하한<br/>§13 배포 · 롤백 칸"]
    G6["tasks<br/>Bolt 계획"]
    G7["mr · 하한<br/>affected · 품질 게이트<br/>리뷰 CRITICAL·HIGH 0"]
    G8["done · 하한<br/>base에 병합됨"]
    G4 --> G5 --> G6 --> G7 --> G8
  end
  subgraph REL["배포 기록"]
    direction TB
    G9["deploy<br/>PLAN 구간 · D1~D7"]
  end
  ST -. "게이트마다 같은 규칙" .-> INT
  INT -- "Unit마다 이슈" --> ISS
  ISS -- "배포 묶음" --> REL
  classDef floor fill:#fbe6e9,stroke:#c8102e,stroke-width:2.5px,color:#c8102e
  classDef opt fill:#ffffff,stroke:#c8102e,stroke-width:1.5px,stroke-dasharray:5 4,color:#14213d
  classDef design fill:#e7eafb,stroke:#3046c5,stroke-width:2px,color:#14213d
  classDef ops fill:#ddf2eb,stroke:#0b7a5e,stroke-width:2px,color:#14213d
  classDef plain fill:#ffffff,stroke:#14213d,stroke-width:2px,color:#14213d
  classDef store fill:#f5f7fa,stroke:#6b778c,stroke-width:1.5px,color:#46536b
  class D design
  class IR plain
  class AP ops
  class SU store
  class G4,G5,G7,G8 floor
  class G1,G2,G3,G6,G9 opt
