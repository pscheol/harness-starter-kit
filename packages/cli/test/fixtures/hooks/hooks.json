{
  "schema": "knots-sync.hooks/v1",
  "hooks": [
    { "id": "harness-a-start", "event": "session-start", "script": "scripts/hooks/a.sh", "timeoutSec": 15, "owner": "kit",
      "env": { "KNS_HARNESS": { "claude": "claude", "codex": "codex", "kiro": "kiro" }, "B_FLAG": { "kiro": "1" } }, "maxOutputBytes": 100, "title": "시작" },
    { "id": "harness-b-guard", "event": "pre-tool", "tools": ["write", "shell"], "script": "scripts/hooks/b.sh", "timeoutSec": 10, "owner": "kit",
      "floor": true, "subagents": true, "description": "쓰기 · 셸 둘 다" },
    { "id": "harness-c-shell", "event": "pre-tool", "tools": ["shell"], "script": "scripts/hooks/c.sh", "timeoutSec": 5, "owner": "user" },
    { "id": "harness-d-post", "event": "post-tool", "tools": ["write"], "script": "scripts/hooks/d.sh", "timeoutSec": 20, "owner": "kit", "subagents": true },
    { "id": "harness-e-prompt", "event": "user-prompt", "script": "scripts/hooks/e.sh", "timeoutSec": 15, "owner": "kit" },
    { "id": "harness-f-mod", "event": "stop", "script": "scripts/hooks/f.sh", "timeoutSec": 60, "owner": "pack:acme", "module": "jira-workflow" },
    { "id": "harness-g-stop", "event": "stop", "script": "scripts/hooks/g.sh", "timeoutSec": 180, "owner": "kit", "harnesses": ["claude", "kiro"] },
    { "id": "harness-h-end", "event": "session-end", "script": "scripts/hooks/h.sh", "timeoutSec": 15, "owner": "kit" },
    { "id": "harness-i-wt-create", "event": "worktree-create", "script": "scripts/hooks/i.sh", "timeoutSec": 60, "owner": "kit", "harnesses": ["claude"] },
    { "id": "harness-j-wt-remove", "event": "worktree-remove", "script": "scripts/hooks/j.sh", "timeoutSec": 60, "owner": "kit", "harnesses": ["claude"] }
  ]
}
