{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Edit(//**/{{PROTECTED_PATH}}/**)",
      "Edit(//**/approvals.md)",
      "Edit(//**/.agents/quality-baseline.json)",
      "Edit(//**/.agents/state/dashboard.token)",
      "Edit(//**/.agents/state/approvals-log.jsonl)",
      "Read(//**/.agents/state/dashboard.token)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/protect-sources.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/block-full-verify.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/protect-approvals.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 180,
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/verify-gate.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true
  }
}
