#!/usr/bin/env bash
# push 전에 전역 pre-push 에 같은 ref 목록을 넘기고, 브랜치 이름 규칙을 본 뒤, 올리는 커밋의 변경만 검증한다.
# 연결은 하네스 루트에서 `bash scripts/install-git-hooks.sh`.
set -uo pipefail
HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HARNESS_ROOT="$(cd "$HOOKS_DIR/../.." && pwd)"
. "$HOOKS_DIR/global-hook.sh"

# stdin 은 한 번만 읽힌다. 전역 hook 과 아래 판정이 같은 ref 목록을 보게 파일에 담아 둔다.
refs="$(mktemp "${TMPDIR:-/tmp}/pre-push-refs.XXXXXX")" || exit 1
trap 'rm -f "$refs"' EXIT
cat >"$refs"

if global="$(global_hook pre-push)"; then
  echo "▶ 전역 pre-push — $global"
  "$global" "$@" <"$refs" || exit $?
fi

# 로컬 sha 가 모두 0 이면 원격 브랜치를 지우기만 하는 push 다. 빌드·테스트가 필요 없다.
pushes=0
while read -r _ local_sha _; do
  case "$local_sha" in
    *[!0]*) pushes=$((pushes + 1)) ;;
  esac
done <"$refs"
if [ "$pushes" -eq 0 ]; then
  echo "↷ 올리는 커밋이 없는 push — 리포 게이트 생략"
  exit 0
fi

level="${HARNESS_VERIFY_LEVEL:-changed}"
case "$level" in changed|fast|full) ;; *) echo "알 수 없는 검증 레벨: $level" >&2; exit 2 ;; esac
if [ "$level" = changed ] && [ -f "$HARNESS_ROOT/scripts/verify-changed.py" ]; then
  scopes="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-scopes.XXXXXX")" || exit 1
  trap 'rm -f "$refs"; rm -rf "$scopes"' EXIT
  scope=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in ''|*[!0]*) ;; *) continue ;; esac
    scope=$((scope + 1))
    paths="$scopes/$scope.paths"
    printf '%s\n%s\n' "$remote_sha" "$local_sha" >"$scopes/$scope.refs"
    case "$remote_sha" in
      *[!0]*)
        if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
          echo "검증 미완료: push 비교 기준 커밋을 로컬에서 읽을 수 없다: $remote_sha" >&2
          exit 2
        fi
        git diff --name-only -z "$remote_sha" "$local_sha" >"$paths" || exit $?
        continue ;;
    esac
    git ls-tree -r --name-only -z "$local_sha" >"$paths" || exit $?
  done <"$refs"
fi
unset $(git rev-parse --local-env-vars)
# 브랜치 이름 <종류>/<이슈키>-<이름> 이면 올리는 커밋에 그 키의 이슈 폴더가 있어야 한다(R7.8). exp/ 는 보지 않는다.
if [ -f "$HARNESS_ROOT/scripts/sdd-layout.py" ]; then
  python3 "$HARNESS_ROOT/scripts/sdd-layout.py" branch-check "$refs" </dev/null || exit 1
fi
if [ "$level" = changed ] && [ -f "$HARNESS_ROOT/scripts/verify-changed.py" ]; then
  echo "▶ 리포 게이트(changed — push ref 파일) — $HARNESS_ROOT"
  for selected in "$scopes/"*.paths; do
    files=()
    while IFS= read -r -d '' path; do files+=("$path"); done <"$selected"
    if [ "${#files[@]}" -eq 0 ]; then
      echo "검증 생략: 올리는 ref에 변경 파일이 없다. full 통과를 뜻하지 않는다."
      continue
    fi
    { read -r base; read -r head; } <"${selected%.paths}.refs"
    python3 "$HARNESS_ROOT/scripts/verify-changed.py" --files "${files[@]}" \
      --gitlink-base "$base" --gitlink-head "$head" </dev/null || exit $?
  done
else
  [ "$level" = changed ] && level=fast
  echo "▶ 리포 게이트($level) — $HARNESS_ROOT"
  HARNESS_VERIFY_LEVEL="$level" bash "$HARNESS_ROOT/scripts/verify.sh" </dev/null
fi
