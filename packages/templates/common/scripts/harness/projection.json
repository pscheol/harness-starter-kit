{
  "schema": "harness-kit.projection/v1",
  "claudeBlock": [
    "<!-- harness-kit:begin claude — 이 블록은 harness-kit 이 관리한다. 블록 밖은 프로젝트 몫이다 -->",
    "## Claude Code 전용",
    "",
    "- 스킬 `.claude/skills/`, 규칙 `.claude/rules/`, 역할 `.claude/agents/`는 `.agents/` 원본에서 만든 복사본 · 생성물이다. 고칠 때는 `.agents/`의 원본을 고치고 `npx harness-kit repair`로 다시 만든다(Node가 없으면 `python3 scripts/harness/projection.py sync`).",
    "- 규칙은 `.claude/rules/`에서 자동으로 실린다. `paths`가 있는 규칙은 그 경로의 파일을 다룰 때 실린다.",
    "- 복사본이 원본과 어긋나면 `bash scripts/verify.sh --fast`의 배치 검사(`scripts/harness/check_layout.py`)가 알린다.",
    "<!-- harness-kit:end claude -->"
  ],
  "claudeSettings": {
    "deny": [
      "Edit(//**/{{PROTECTED_PATH}}/**)",
      "Edit(//**/approvals.md)",
      "Edit(//**/.agents/quality-baseline.json)",
      "Edit(//**/.agents/state/dashboard.token)",
      "Edit(//**/.agents/state/approvals-log.jsonl)",
      "Read(//**/.agents/state/dashboard.token)"
    ],
    "hooks": [
      {
        "id": "harness-session-start",
        "event": "SessionStart",
        "script": "scripts/hooks/session-start.sh",
        "hook": {
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-start.sh"
        }
      },
      {
        "id": "harness-session-register",
        "event": "SessionStart",
        "script": "scripts/hooks/session-register.sh",
        "hook": {
          "type": "command",
          "command": "HX_HARNESS=claude bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-register.sh"
        }
      },
      {
        "id": "harness-session-prompt",
        "event": "UserPromptSubmit",
        "script": "scripts/hooks/session-register.sh",
        "hook": {
          "type": "command",
          "command": "HX_HARNESS=claude bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-register.sh"
        }
      },
      {
        "id": "harness-protect-sources",
        "event": "PreToolUse",
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "script": "scripts/hooks/protect-sources.sh",
        "hook": {
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/protect-sources.sh"
        }
      },
      {
        "id": "harness-block-full-verify",
        "event": "PreToolUse",
        "matcher": "Bash",
        "script": "scripts/hooks/block-full-verify.sh",
        "hook": {
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/block-full-verify.sh"
        }
      },
      {
        "id": "harness-protect-approvals",
        "event": "PreToolUse",
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "script": "scripts/hooks/protect-approvals.sh",
        "hook": {
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/protect-approvals.sh"
        }
      },
      {
        "id": "harness-verify-gate",
        "event": "Stop",
        "script": "scripts/hooks/verify-gate.sh",
        "hook": {
          "type": "command",
          "timeout": 180,
          "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/verify-gate.sh"
        }
      },
      {
        "id": "harness-session-idle",
        "event": "Stop",
        "script": "scripts/hooks/session-register.sh",
        "hook": {
          "type": "command",
          "command": "HX_HARNESS=claude bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-register.sh"
        }
      },
      {
        "id": "harness-session-end",
        "event": "SessionEnd",
        "script": "scripts/hooks/session-register.sh",
        "hook": {
          "type": "command",
          "command": "HX_HARNESS=claude bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-register.sh"
        }
      }
    ]
  },
  "codexConfig": {
    "header": [
      "# 리포 정책만 둔다. 사용자 전역 MCP·자격증명·절대경로 설정은 복사하지 않는다.",
      "# 상위 하네스 안에서는 git 리포 루트의 .codex/config.toml 도 읽히고, 같은 키는 이 파일이 이긴다.",
      "# config_file 의 상대경로는 이 .codex/ 폴더 기준이다.",
      "# 샌드박스·승인 정책은 사용자 설정을 따른다. 역할별 sandbox_mode 만 agents/*.toml 이 정한다."
    ],
    "defaults": [
      {
        "table": "features",
        "key": "multi_agent",
        "line": "multi_agent = true"
      },
      {
        "table": "agents",
        "key": "max_threads",
        "line": "max_threads = 6"
      }
    ],
    "tables": [
      {
        "table": "shell_environment_policy",
        "lines": [
          "inherit = \"core\"",
          "ignore_default_excludes = false",
          "exclude = [\"*_KEY\", \"*_SECRET\", \"*_TOKEN\", \"*_PASSWORD\", \"*PASSWD*\", \"AWS_*\", \"*_DSN\"]"
        ]
      }
    ]
  },
  "gitattributes": {
    "claude": [
      ".claude/skills/**",
      ".claude/rules/**",
      ".claude/agents/**"
    ],
    "codex": [
      ".codex/agents/**"
    ],
    "cursor": [
      ".cursor/commands/**",
      ".cursor/rules/**"
    ],
    "kiro": [
      ".kiro/skills/**",
      ".kiro/steering/**",
      ".kiro/agents/**"
    ]
  },
  "kiroWriteHooks": {
    "preToolUse": [
      {
        "matcher": "write",
        "command": "bash -c 'r=\"$PWD\"; while [ \"$r\" != / ] && [ ! -f \"$r/.agents/harness.json\" ]; do r=\"$(dirname \"$r\")\"; done; h=\"$r/scripts/hooks/$1\"; [ -f \"$h\" ] || exit 0; exec bash \"$h\"' _ protect-sources.sh",
        "timeout_ms": 15000
      },
      {
        "matcher": "write",
        "command": "bash -c 'r=\"$PWD\"; while [ \"$r\" != / ] && [ ! -f \"$r/.agents/harness.json\" ]; do r=\"$(dirname \"$r\")\"; done; h=\"$r/scripts/hooks/$1\"; [ -f \"$h\" ] || exit 0; exec bash \"$h\"' _ protect-approvals.sh",
        "timeout_ms": 15000
      }
    ]
  },
  "readOnlyLine": "파일을 고치지 않는다. apply_patch 와 파일을 쓰는 셸 명령을 쓰지 않는다(이 역할은 read-only 다)."
}
