{
  "schema": "knots-sync.analyzers/v1",
  "analyzers": [
    {"id": "gitleaks", "layer": "common", "category": "secret", "required": true, "levels": ["changed", "affected", "full"], "scope": "files", "cmd": ["gitleaks", "dir", "{targetsDir}", "--report-format", "sarif", "--report-path", "{out}", "--exit-code", "0", "--redact", "--no-banner", "--log-level", "warn"], "sarif": "native", "versionCmd": ["gitleaks", "version"], "minVersion": "8.19.0", "timeoutSec": 120, "license": "MIT"},
    {"id": "semgrep", "layer": "common", "category": "security", "required": true, "alternatives": ["opengrep"], "levels": ["changed", "affected", "full"], "scope": "files", "cmd": ["semgrep", "scan", "--config", "{rules}", "--sarif", "--output", "{out}", "--metrics", "off", "--disable-version-check", "--quiet", "{targets}"], "rules": {"source": "registry:p/default", "license": "Semgrep Rules License v1.0", "bundled": false}, "sarif": "native", "versionCmd": ["semgrep", "--version"], "timeoutSec": 300, "license": "LGPL-2.1"},
    {"id": "osv-scanner", "layer": "common", "category": "dependency", "required": true, "alternatives": [{"tool": "trivy", "cmd": ["trivy", "fs", "--scanners", "vuln", "--format", "sarif", "--output", "{out}", "--quiet", "{root}"], "versionCmd": ["trivy", "--version"], "minVersion": "0.50.0"}], "levels": ["changed", "affected", "full"], "scope": "lockfiles", "trigger": ["**/package-lock.json", "**/pnpm-lock.yaml", "**/yarn.lock", "**/uv.lock", "**/poetry.lock", "**/requirements*.txt", "**/go.sum", "**/gradle.lockfile", "**/build.gradle*", "**/pom.xml", "**/Cargo.lock"], "cmd": ["osv-scanner", "scan", "source", "--recursive", "--format", "sarif", "--output-file", "{out}", "--allow-no-lockfiles", "{root}"], "sarif": "native", "versionCmd": ["osv-scanner", "--version"], "minVersion": "2.0.0", "timeoutSec": 300, "license": "Apache-2.0"},
    {"id": "jscpd", "layer": "common", "category": "duplication", "required": false, "levels": ["affected", "full"], "scope": "modules", "include": ["**/*.py", "**/*.java", "**/*.kt", "**/*.kts", "**/*.go", "**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.cjs", "**/*.swift", "**/*.rb", "**/*.php", "**/*.c", "**/*.cc", "**/*.cpp", "**/*.h", "**/*.cs", "**/*.rs", "**/*.scala", "**/*.dart"], "cmd": ["jscpd", "--reporters", "json", "--output", "{tmp}", "--min-lines", "10", "--silent", "--absolute", "--ignore", "**/node_modules/**,**/.venv/**,**/build/**,**/dist/**,**/.agents/**", "{modules}"], "raw": "{tmp}/jscpd-report.json", "sarif": "convert:jscpd", "versionCmd": ["jscpd", "--version"], "timeoutSec": 300, "license": "MIT"},
    {"id": "lizard", "layer": "common", "category": "complexity", "required": false, "levels": ["changed", "affected", "full"], "scope": "files", "include": ["**/*.py", "**/*.java", "**/*.kt", "**/*.kts", "**/*.go", "**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.cjs", "**/*.swift", "**/*.rb", "**/*.php", "**/*.c", "**/*.cc", "**/*.cpp", "**/*.h", "**/*.cs", "**/*.rs", "**/*.scala", "**/*.dart"], "cmd": ["lizard", "--csv", "-x", "*/node_modules/*", "-x", "*/.venv/*", "-x", "*/build/*", "-x", "*/dist/*", "{targets}"], "stdout": "{tmp}/lizard.csv", "sarif": "convert:lizard", "convertArgs": ["--threshold", "{ccn}"], "versionCmd": ["lizard", "--version"], "timeoutSec": 180, "license": "MIT"},
    {"id": "ruff", "layer": "stack:python", "category": "lint", "required": false, "levels": ["changed", "affected", "full"], "scope": "files", "include": ["**/*.py"], "cmd": ["ruff", "check", "--output-format", "sarif", "--output-file", "{out}", "--exit-zero", "--no-cache", "{targets}"], "severityMap": {"S[0-9]*": "HIGH", "*": "LOW"}, "sarif": "native", "versionCmd": ["ruff", "--version"], "timeoutSec": 120, "license": "MIT"},
    {"id": "bandit", "layer": "stack:python", "category": "security", "required": false, "levels": ["changed", "affected", "full"], "scope": "files", "include": ["**/*.py"], "cmd": ["bandit", "-q", "-f", "sarif", "-o", "{out}", "--exit-zero", "-x", "./.venv,./node_modules", "-r", "{targets}"], "sarif": "native", "versionCmd": ["bandit", "--version"], "timeoutSec": 180, "license": "Apache-2.0", "note": "SARIF 출력은 bandit[sarif] 로 설치한다"},
    {"id": "mypy", "layer": "stack:python", "category": "type", "required": false, "levels": ["affected", "full"], "scope": "modules", "include": ["**/*.py"], "cmd": ["mypy", "-O", "json", "--no-error-summary", "{modules}"], "stdout": "{tmp}/mypy.json", "sarif": "convert:mypy", "versionCmd": ["mypy", "--version"], "minVersion": "1.11.0", "timeoutSec": 300, "license": "MIT"}
  ]
}
